# ========================================================
# VK TECHNOLOGY E-COMMERCE PLATFORM - PRODUCTION ENV CONFIG
# ========================================================

# Application Mode & Port
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://www.vktechnology.shop
API_BASE_URL=https://www.vktechnology.shop/api

# --------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Neon / Supabase)
# --------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/vktechnology?sslmode=require"

# --------------------------------------------------------
# 2. Authentication & Session Security
# --------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_cookie_secret_key_random_string

# Admin Owner Credentials
ADMIN_EMAIL=admin@vktechnology.shop
ADMIN_INITIAL_PASSWORD=ChangeMeOnFirstLogin@2026!

# --------------------------------------------------------
# 3. Razorpay Online Payment Gateway (India)
# --------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# --------------------------------------------------------
# 4. Transactional Email Notifications
# --------------------------------------------------------
RESEND_API_KEY=re_YourResendApiKeyHere
EMAIL_FROM="VK Technology <orders@vktechnology.shop>"

# --------------------------------------------------------
# 5. WhatsApp Business Notifications (Meta Cloud API)
# --------------------------------------------------------
WHATSAPP_API_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_PHONE=+918555997052
OWNER_WHATSAPP_NUMBER=+918555997052

# --------------------------------------------------------
# 6. Persistent Image & Object Storage (Cloudinary / S3)
# --------------------------------------------------------
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
